import helpers.add

scene start():
    var count = 0
    fun bump() -> Int:
        count += 1
        return count
    fun read() -> Int = count
    suspend fun ask() -> Int:
        choice:
            option "Hidden ${bump()}" if false:
                return 99
            option "Take ${bump()} and \${literal}":
                return 10

    val action = ::bump
    val reader = ::read
    val total = add(action()) + ask()
    prose:
        Result ${total}; counter ${reader()}; next ${action()}; after ${reader()}.
